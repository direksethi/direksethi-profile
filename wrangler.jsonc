{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "direksethi",
  "main": "src/index.js",
  "compatibility_date": "2026-08-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker must see every request so it can apply the www -> apex
    // redirect, cache policy and security headers before assets are served.
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "direksethi.com", "custom_domain": true },
    { "pattern": "www.direksethi.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
